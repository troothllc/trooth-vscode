{
  "name": "trooth-vscode",
  "displayName": "Trooth",
  "description": "Scaffold of the Trooth extension for VS Code and Cursor. It opens trooth.co pages in your browser and makes no network request of its own; it reads no records and checks no signatures.",
  "version": "0.1.1",
  "publisher": "troothllc",
  "license": "Apache-2.0",
  "homepage": "https://www.trooth.co",
  "repository": {
    "type": "git",
    "url": "https://github.com/troothllc/trooth-vscode.git"
  },
  "bugs": {
    "url": "https://github.com/troothllc/trooth-vscode/issues"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "trooth",
    "trooth-network"
  ],
  "main": "./src/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "trooth.scan",
        "title": "Show Trust Center and API Docs Links",
        "category": "Trooth"
      },
      {
        "command": "trooth.checkDrift",
        "title": "Show How to Read a Record from the Terminal",
        "category": "Trooth"
      },
      {
        "command": "trooth.verifyReceipt",
        "title": "Choose a JSON File (No Signature Check)",
        "category": "Trooth"
      },
      {
        "command": "trooth.showTrustCenter",
        "title": "Open Trooth's Trust Center",
        "category": "Trooth"
      },
      {
        "command": "trooth.openTrustProfile",
        "title": "Open trooth.co",
        "category": "Trooth"
      }
    ],
    "configuration": {
      "title": "Trooth",
      "properties": {
        "trooth.apiKey": {
          "type": "string",
          "default": "",
          "description": "Not used by this version: it has no effect and is never sent anywhere. Settings files can be committed, so do not store a real key here."
        },
        "trooth.host": {
          "type": "string",
          "default": "https://api.trooth.co",
          "description": "Not used by this version, which makes no network request of its own."
        },
        "trooth.frameworks": {
          "type": "string",
          "default": "",
          "description": "Not used by this version."
        },
        "trooth.showStatusBar": {
          "type": "boolean",
          "default": true,
          "description": "Show the Trooth item in the status bar. Clicking it shows links to Trooth's Trust Center and API docs."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "echo 'No build step for v0.1'",
    "smoke": "node -e \"require('./src/extension.js'); console.log('extension loads')\""
  },
  "devDependencies": {},
  "dependencies": {}
}
