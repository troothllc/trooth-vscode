{
  "name": "trooth-vscode",
  "displayName": "Trooth",
  "description": "Scaffold of the Trooth extension for VS Code and Cursor. It opens trooth.co pages in your browser and makes no network request of its own; it reads no records, checks no signatures and asks for no key.",
  "version": "0.1.2",
  "publisher": "troothllc",
  "license": "Apache-2.0",
  "homepage": "https://www.trooth.co",
  "repository": {
    "type": "git",
    "url": "https://github.com/troothllc/trooth-vscode.git"
  },
  "bugs": {
    "url": "https://github.com/troothllc/trooth-vscode/issues"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "trooth",
    "trooth-network"
  ],
  "main": "./src/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "trooth.scan",
        "title": "Show Trust Center and API Docs Links",
        "category": "Trooth"
      },
      {
        "command": "trooth.checkDrift",
        "title": "Show How to Read a Record from the Terminal",
        "category": "Trooth"
      },
      {
        "command": "trooth.showSignatureInstructions",
        "title": "Open How to Check a Signature",
        "category": "Trooth"
      },
      {
        "command": "trooth.showTrustCenter",
        "title": "Open Trooth's Trust Center",
        "category": "Trooth"
      },
      {
        "command": "trooth.openTrustProfile",
        "title": "Open trooth.co",
        "category": "Trooth"
      }
    ],
    "configuration": {
      "title": "Trooth",
      "properties": {
        "trooth.showStatusBar": {
          "type": "boolean",
          "default": true,
          "description": "Show the Trooth item in the status bar. Clicking it shows links to Trooth's Trust Center and API docs."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "echo 'No build step for v0.1'",
    "smoke": "node scripts/smoke.js"
  },
  "devDependencies": {},
  "dependencies": {}
}
